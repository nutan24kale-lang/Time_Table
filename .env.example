# Smart Timetable Scheduler - Environment Configuration

# Optional: Set the production backend URL when deploying frontend to Netlify
# Example: VITE_API_BASE_URL=https://your-backend-api.onrender.com/api
# In local development, leave this blank to automatically use the Vite proxy (http://localhost:5000/api)
VITE_API_BASE_URL=

# Backend Port (default is 5000)
PORT=5000

# JWT Secret Key for backend authentication
JWT_SECRET=supersecret_jwt_key_timetable_2026
